{
  "appId": "com.golumo.app",
  "appName": "Lumo",
  "webDir": "native-shell",
  "server": {
    "url": "https://golumo.app",
    "cleartext": false,
    "allowNavigation": ["golumo.app", "*.golumo.app", "auth.emergentagent.com", "checkout.stripe.com", "*.stripe.com"]
  },
  "ios": { "contentInset": "never", "backgroundColor": "#0f172a" },
  "android": { "backgroundColor": "#0f172a", "allowMixedContent": false },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0f172a" },
    "Keyboard": { "resize": "body", "style": "DARK" },
    "FirebaseMessaging": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
